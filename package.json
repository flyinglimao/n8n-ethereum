{
  "name": "@0xlimao/n8n-nodes-ethereum",
  "version": "1.1.0",
  "description": "Comprehensive Ethereum blockchain integration for n8n with unified node structure using viem",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:n8n": "N8N_USER_FOLDER=/tmp/.test-n8n n8n",
    "test:node": "node tests/scripts/start-hardhat-network.mjs",
    "test:setup": "node tests/scripts/setup.mjs",
    "test:deploy": "node tests/scripts/deploy-contracts.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.ts\""
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "ethereum",
    "blockchain",
    "viem",
    "web3"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/EthereumRpc.credentials.js",
      "dist/credentials/EthereumAccount.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Ethereum/Ethereum.node.js",
      "dist/nodes/EthereumTrigger/EthereumTrigger.node.js"
    ]
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "viem": "^2.54.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-viem": "^3.0.1",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/node": "^24.10.9",
    "eslint": "^9.39.2",
    "gulp": "^5.0.1",
    "hardhat": "^3.1.2",
    "n8n-workflow": "^2.16.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.0.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flyinglimao/n8n-ethereum.git"
  },
  "files": [
    "dist"
  ]
}
